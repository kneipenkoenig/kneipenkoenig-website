{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kneipenkoenig Registration Projection v1",
  "description": "Internal quiz-preparation projection; no contact details or credentials. Proposed contract, not deployed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_id",
    "event_id",
    "ticket_id",
    "version",
    "status",
    "starts_at",
    "location",
    "team",
    "checked_in",
    "check_in_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registration_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "ticket_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "confirmed",
        "cancelled"
      ]
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_team_id",
        "scoremaster_team_id",
        "name",
        "ticket_capacity"
      ],
      "properties": {
        "event_team_id": {
          "type": "string",
          "format": "uuid"
        },
        "scoremaster_team_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 20
        },
        "ticket_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum seats included in the team ticket; not measured attendance."
        },
        "name_source": {
          "enum": [
            "buyer",
            "staff",
            "fallback",
            null
          ]
        }
      }
    },
    "table_label": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60
    },
    "checked_in": {
      "type": "boolean"
    },
    "check_in_required": {
      "type": "boolean"
    }
  }
}
